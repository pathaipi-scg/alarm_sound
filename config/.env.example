# MiniPC alarm_sound deployment example. Copy to .env and supply site values.
OPC_URL=opc.tcp://opc-host.example.local:49320
SQL_DRIVER=AUTO
SQL_SERVER=sql-host.example.local
SQL_DB=database_name
SQL_USER=database_user
SQL_PASS=change-me
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=true

# alarm_sound local/service-visible playback root; filename identity must match Alarm_Lists.
MP3_FOLDER=C:\path\to\Alarm
RELOAD_ALARM_NODE=
